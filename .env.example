# Copy this file to .env and fill in real values locally. Never commit .env -
# it's gitignored on purpose. Client-side (VITE_*) values are bundled into the
# browser build and are not secret by nature (Supabase's anon key is designed
# to be public and protected by RLS instead) - everything else here IS a
# secret and must only ever be set server-side (Vercel env vars / Supabase
# secrets), never exposed to the client bundle.

# ---- Supabase (client-side, safe to expose - protected by RLS) ----
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- Supabase (server-side only - Vercel env vars / Supabase secrets) ----
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ---- Resend (transactional email) ----
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# ---- Vercel Cron auth shared secret (api/cron.js <-> Supabase Edge Functions) ----
CRON_SECRET=

# ---- Stripe (Billing integration - scaffolding only, not yet wired up) ----
# See INVOICING_INFRASTRUCTURE.md for the planned integration. Never use a
# live secret key outside of a production Stripe account with real billing
# terms configured - use test-mode keys (sk_test_/whsec_test_...) during
# development.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Invoicing API (regional invoice generation - scaffolding only) ----
INVOICE_API_KEY=
